// Cloudflare Workers, режим «только статика». Файла _redirects нет намеренно:
// Workers считает правило «всё на index.html» бесконечным циклом, а SPA-роутинг
// включается здесь через not_found_handling. Деплой из панели: build
// `npm run build`, deploy `npx wrangler deploy`, root directory `app`.
{
  "name": "spend",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
